[Unit]
Description=Wiren Board URRI receiver MQTT driver
Wants=mosquitto.service
After=network.target mosquitto.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/wb-mqtt-urri
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=2 6
SuccessExitStatus=7

[Install]
WantedBy=multi-user.target
